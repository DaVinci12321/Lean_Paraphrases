theorem classify_positive_integer_pairs (a b : ℕ) (ha : 0 < a) (hb : 0 < b) : ((((b : ℤ) ^ 2 - (a : ℤ)) ∣ ((a : ℤ) ^ 2 + (b : ℤ))) ∧ (((a : ℤ) ^ 2 - (b : ℤ)) ∣ ((b : ℤ) ^ 2 + (a : ℤ)))) ↔ ((a = 2 ∧ b = 2) ∨ (a = 3 ∧ b = 3) ∨ (a = 1 ∧ b = 2) ∨ (a = 2 ∧ b = 3) ∨ (a = 2 ∧ b = 1) ∨ (a = 3 ∧ b = 2)) := by sorry
theorem product_one_sum_ge_card (n : ℕ) (hn : 0 < n) (a : Fin n → ℝ) (ha : ∀ i, 0 < a i) (hprod : ∏ i, a i = 1) : (n : ℝ) ≤ ∑ i, a i := by sorry
