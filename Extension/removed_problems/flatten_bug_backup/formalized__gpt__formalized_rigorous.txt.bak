theorem functional_count (F : ℕ → ℕ) (h₁ : ∀ n : ℕ, F (4 * n) = F (2 * n) + F n) (h₂ : ∀ n : ℕ, F (4 * n + 2) = F (4 * n) + 1) (h₃ : ∀ n : ℕ, F (2 * n + 1) = F (2 * n) + 1) : ∀ m : ℕ, 0 < m → ((Finset.range (2 ^ m)).filter (fun n => F (4 * n) = F (3 * n))).card = F (2 ^ (m + 1)) := by sorry
