theorem sum_representable_integers : ∑ n in (Finset.range 2016).filter (fun n => 0 < n ∧ ∃ x y : ℕ, 0 < x ∧ 0 < y ∧ n = (x + 1) / 2 + y + x * y), n = 2029906 := by sorry
theorem sine_lengths_triangle_area (α β γ : ℝ) (hα : 0 < α) (hβ : 0 < β) (hγ : 0 < γ) (hsum : α + β + γ < Real.pi) (hab : α + β > γ) (hbc : β + γ > α) (hca : γ + α > β) : Real.sin α + Real.sin β > Real.sin γ ∧ Real.sin β + Real.sin γ > Real.sin α ∧ Real.sin γ + Real.sin α > Real.sin β ∧ (1 / 4 : ℝ) * Real.sqrt ((Real.sin α + Real.sin β + Real.sin γ) * (-Real.sin α + Real.sin β + Real.sin γ) * (Real.sin α - Real.sin β + Real.sin γ) * (Real.sin α + Real.sin β - Real.sin γ)) ≤ (1 / 8 : ℝ) * (Real.sin (2 * α) + Real.sin (2 * β) + Real.sin (2 * γ)) := by sorry
theorem triangle_cosine_inequality (x y z α β γ : ℝ) (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (hα : α ∈ Set.Ico (0 : ℝ) Real.pi) (hβ : β ∈ Set.Ico (0 : ℝ) Real.pi) (hγ : γ ∈ Set.Ico (0 : ℝ) Real.pi) (hαβ : α + β > γ) (hαγ : α + γ > β) (hβγ : β + γ > α) : Real.sqrt (x ^ 2 + y ^ 2 - 2 * x * y * Real.cos α) + Real.sqrt (y ^ 2 + z ^ 2 - 2 * y * z * Real.cos β) ≥ Real.sqrt (z ^ 2 + x ^ 2 - 2 * z * x * Real.cos γ) := by sorry
theorem classify_modular_equivalence (n : ℕ) (hn : 2 ≤ n) : (∀ a b : ℕ, Nat.gcd a n = 1 → Nat.gcd b n = 1 → (Nat.ModEq n a b ↔ Nat.ModEq n (a * b) 1)) ↔ n ∈ ({2, 3, 4, 6, 8, 12, 24} : Finset ℕ) := sorry
