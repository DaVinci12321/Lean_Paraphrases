theorem least_positive_consecutive_square_digit_seven : (0 < (27 : ℕ) ∧ 7 ∈ Nat.digits 10 (27 ^ 2) ∧ 7 ∈ Nat.digits 10 ((27 + 1) ^ 2) ∧ 7 ∉ Nat.digits 10 ((27 + 2) ^ 2)) ∧ ∀ n : ℕ, 0 < n → 7 ∈ Nat.digits 10 (n ^ 2) → 7 ∈ Nat.digits 10 ((n + 1) ^ 2) → 7 ∉ Nat.digits 10 ((n + 2) ^ 2) → 27 ≤ n := by sorry
