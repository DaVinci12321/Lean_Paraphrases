theorem sequence_value_2002 (a : ℕ → ℕ) (hpos : ∀ n : ℕ, 0 < n → 0 < a n) (h₁ : a 1 = 1) (hrec : ∀ n : ℕ, 1 < n → a n = Nat.gcd (a (n - 1)) n + 1) : a 2002 = 3 := by sorry
theorem sequence_characterization (n : ℕ) (x : ℕ → ℕ) (hn : 1 < n) (hpos : ∀ i, 1 ≤ i → i < n → 0 < x i) (hinc : ∀ i j, 1 ≤ i → i < j → j < n → x i < x j) (hsym : ∀ i, 1 ≤ i → i < n → x i + x (n - i) = 2 * n) (hclosed : ∀ i j, 1 ≤ i → i < n → 1 ≤ j → j < n → x i + x j < 2 * n → ∃ k, 1 ≤ k ∧ k < n ∧ x i + x j = x k) : ∀ i, 1 ≤ i → i < n → x i = 2 * i := by sorry
