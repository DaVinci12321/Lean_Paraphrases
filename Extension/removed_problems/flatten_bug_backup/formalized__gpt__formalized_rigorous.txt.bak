theorem exists_dirichlet_function_with_no_least_positive_period : ∃ D : ℝ → ℝ, (∀ x : ℝ, Irrational x → D x = 0) ∧ (∀ x : ℝ, (∃ q : ℚ, x = (q : ℝ)) → D x = 1) ∧ (∀ x c : ℝ, 0 < c → D (x + c) = D x) ∧ ¬ ∃ c : ℝ, IsLeast {d : ℝ | 0 < d ∧ ∀ x : ℝ, D (x + d) = D x} c := by sorry
theorem fair_subset_sum_game (k : ℕ) (hk₁ : 1 ≤ k) (hk₂ : k ≤ 1986) : (let Ω := (Finset.Icc 1 1986 : Finset ℕ).powersetCard k ((Ω.filter fun S => S.sum id % 3 = 0).card : ℚ) / Ω.card = 1 / 3 ∧ ((Ω.filter fun S => S.sum id % 3 = 1).card : ℚ) / Ω.card = 1 / 3 ∧ ((Ω.filter fun S => S.sum id % 3 = 2).card : ℚ) / Ω.card = 1 / 3) ↔ k = 660 ∨ k = 1320 := by sorry
