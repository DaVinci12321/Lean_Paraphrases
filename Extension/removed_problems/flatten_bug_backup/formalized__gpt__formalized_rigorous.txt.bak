theorem minimum_max_three_consecutive : (∀ a b c d e f g : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ c → 0 ≤ d → 0 ≤ e → 0 ≤ f → 0 ≤ g → a + b + c + d + e + f + g = 1 → (1 / 3 : ℝ) ≤ max (a + b + c) (max (b + c + d) (max (c + d + e) (max (d + e + f) (e + f + g))))) ∧ (∃ a b c d e f g : ℝ, 0 ≤ a ∧ 0 ≤ b ∧ 0 ≤ c ∧ 0 ≤ d ∧ 0 ≤ e ∧ 0 ≤ f ∧ 0 ≤ g ∧ a + b + c + d + e + f + g = 1 ∧ max (a + b + c) (max (b + c + d) (max (c + d + e) (max (d + e + f) (e + f + g)))) = (1 / 3 : ℝ)) := by sorry
