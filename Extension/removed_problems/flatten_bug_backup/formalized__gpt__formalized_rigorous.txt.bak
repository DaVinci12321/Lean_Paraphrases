theorem cyclic_fraction_inequality (a b c t : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (ht : 0 ≤ t) : a / (b + t * c) + b / (c + t * a) + c / (a + t * b) ≥ 3 / (1 + t) := by sorry
