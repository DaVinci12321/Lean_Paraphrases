theorem greatest_admissible (n : ℕ) (hn : n ≥ 2) : (∃ k : ℕ, ∀ i : ℕ, 0 ≤ i → i < 2 ^ n - 1 → ¬∃ d : ℕ, d > 1 ∧ d ∣ k + i ∧ ∃ m : ℕ, d = m ^ n) ∧ ∀ N : ℕ, (∃ k : ℕ, ∀ i : ℕ, 0 ≤ i → i < N → ¬∃ d : ℕ, d > 1 ∧ d ∣ k + i ∧ ∃ m : ℕ, d = m ^ n) → N ≤ 2 ^ n - 1 := by sorry
