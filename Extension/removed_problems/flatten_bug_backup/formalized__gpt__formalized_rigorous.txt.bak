theorem triangle_fraction_sum_nonpos (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hab : c < a + b) (hbc : a < b + c) (hca : b < c + a) : (c - a) / (b + c - a) + (a - b) / (c + a - b) + (b - c) / (a + b - c) ≤ 0 := by sorry
