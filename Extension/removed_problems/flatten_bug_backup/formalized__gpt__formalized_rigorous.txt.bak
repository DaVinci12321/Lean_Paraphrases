theorem polynomial_sum_of_two_squares (A B C : MvPolynomial (Fin 2) ℝ) (hdegA : A.totalDegree = 2) (hdegB : B.totalDegree = 3) (hdegC : C.totalDegree = 4) (hdisc : ∃ R : MvPolynomial (Fin 2) ℝ, ∀ x y : ℝ, (MvPolynomial.eval ![x, y] B) ^ 2 - 4 * MvPolynomial.eval ![x, y] A * MvPolynomial.eval ![x, y] C = -(MvPolynomial.eval ![x, y] R) ^ 2) (hnonneg : ∀ x y z : ℝ, 0 ≤ MvPolynomial.eval ![x, y] A * z ^ 2 + MvPolynomial.eval ![x, y] B * z + MvPolynomial.eval ![x, y] C) : ∃ F G : MvPolynomial (Fin 3) ℝ, ∀ x y z : ℝ, (MvPolynomial.eval ![x, y, z] F) ^ 2 + (MvPolynomial.eval ![x, y, z] G) ^ 2 = MvPolynomial.eval ![x, y] A * z ^ 2 + MvPolynomial.eval ![x, y] B * z + MvPolynomial.eval ![x, y] C := by sorry
