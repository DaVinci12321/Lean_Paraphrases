theorem classify_integer_functions (f : ℤ → ℤ) : (∀ n : ℤ, n ^ 2 + 4 * f n = (f (f n)) ^ 2) ↔ ((∀ n : ℤ, f n = n + 1) ∨ (∃ a : ℤ, a ≥ 1 ∧ (∀ n : ℤ, n > -a → f n = n + 1) ∧ (∀ n : ℤ, n ≤ -a → f n = -n + 1)) ∨ ((∀ n : ℤ, n > 0 → f n = n + 1) ∧ f 0 = 0 ∧ (∀ n : ℤ, n < 0 → f n = -n + 1))) := by sorry
theorem integer_square_fraction_iff (m n : ℤ) (hm : m ≥ 1) (hn : n ≥ 1) : (∃ k : ℤ, ((5 : ℚ) ^ m + (2 : ℚ) ^ (n + 1)) / ((5 : ℚ) ^ m - (2 : ℚ) ^ (n + 1)) = (k : ℚ) ^ (2 : ℕ)) ↔ m = 1 ∧ n = 1 := by sorry
