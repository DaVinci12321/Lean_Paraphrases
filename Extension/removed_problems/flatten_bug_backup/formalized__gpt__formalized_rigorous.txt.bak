theorem abcd_min_max : (∀ a b c d : ℝ, a + b + c + d = 2 → a * b + a * c + a * d + b * c + b * d + c * d = 0 → (-1 : ℝ) ≤ a * b * c * d ∧ a * b * c * d ≤ (1 : ℝ) / 4) ∧ (∃ a b c d : ℝ, a + b + c + d = 2 ∧ a * b + a * c + a * d + b * c + b * d + c * d = 0 ∧ a * b * c * d = (-1 : ℝ)) ∧ (∃ a b c d : ℝ, a + b + c + d = 2 ∧ a * b + a * c + a * d + b * c + b * d + c * d = 0 ∧ a * b * c * d = (1 : ℝ) / 4) := by sorry
