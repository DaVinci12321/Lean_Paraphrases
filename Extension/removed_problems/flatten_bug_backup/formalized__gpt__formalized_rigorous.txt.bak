theorem polynomial_bounded_by_partial_sum (n : ℕ) (a : ℕ → ℝ) : ∃ k ∈ Finset.range (n + 1), ∀ x ∈ Set.Icc (0 : ℝ) 1, (∑ i ∈ Finset.range (n + 1), a i * x ^ i) ≤ ∑ i ∈ Finset.range (k + 1), a i := by sorry
theorem greatest_prime_divisor_choose_200_100 : IsGreatest {p : ℕ | Nat.Prime p ∧ p ∣ Nat.choose 200 100 ∧ p < 100} 61 := by sorry
theorem minimum_sqrt_expression : (∀ x : ℝ, -1 ≤ x → x ≤ 1 → Real.sqrt 109 ≤ Real.sqrt (58 - 42 * x) + Real.sqrt (149 - 140 * Real.sqrt (1 - x ^ 2))) ∧ (∃ x : ℝ, -1 ≤ x ∧ x ≤ 1 ∧ Real.sqrt (58 - 42 * x) + Real.sqrt (149 - 140 * Real.sqrt (1 - x ^ 2)) = Real.sqrt 109) := by sorry
