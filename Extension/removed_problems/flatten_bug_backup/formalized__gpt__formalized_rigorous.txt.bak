theorem integer_triple_classification (x y z : ℤ) (h₁ : x ^ 2 - y ^ 2 = z) (h₂ : 3 * x * y + (x - y) * z = z ^ 2) : (x = 2 ∧ y = 1 ∧ z = 3) ∨ (x = 1 ∧ y = 2 ∧ z = -3) ∨ (x = 1 ∧ y = 0 ∧ z = 1) ∨ (x = 0 ∧ y = 1 ∧ z = -1) ∨ (x = 0 ∧ y = 0 ∧ z = 0) := by sorry
theorem integral_one_div_sin_fifth (C x : ℝ) (hsin : Real.sin (8 * x) ≠ 0) (hcos : Real.cos (4 * x) ≠ 0) (htan : Real.tan (4 * x) ≠ 0) : HasDerivAt (fun y : ℝ => C + (1 / 128 : ℝ) * (2 * Real.tan (4 * y) ^ 2 + 6 * Real.log |Real.tan (4 * y)| + (1 / 4 : ℝ) * Real.tan (4 * y) ^ 4 - 2 / Real.tan (4 * y) ^ 2 - 1 / (4 * Real.tan (4 * y) ^ 4))) (1 / Real.sin (8 * x) ^ 5) x := by sorry
theorem number_of_distinct_triangles_area_positive_integer : let points := ((Finset.range 2010).product (Finset.range 2010)).filter (fun p : ℕ × ℕ => 41 * p.1 + p.2 = 2009) (((points.product points).filter (fun pq : (ℕ × ℕ) × (ℕ × ℕ) => pq.1 ≠ pq.2 ∧ 0 < Int.natAbs ((pq.1.1 : ℤ) * (pq.2.2 : ℤ) - (pq.2.1 : ℤ) * (pq.1.2 : ℤ)) ∧ Int.natAbs ((pq.1.1 : ℤ) * (pq.2.2 : ℤ) - (pq.2.1 : ℤ) * (pq.1.2 : ℤ)) % 2 = 0)).card / 2) = 600 := by sorry
theorem median_inequality (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (h₁ : a < b + c) (h₂ : b < c + a) (h₃ : c < a + b) : 0 ≤ (Real.sqrt (2 * b ^ 2 + 2 * c ^ 2 - a ^ 2) / 2) * (b * c - a ^ 2) + (Real.sqrt (2 * c ^ 2 + 2 * a ^ 2 - b ^ 2) / 2) * (c * a - b ^ 2) + (Real.sqrt (2 * a ^ 2 + 2 * b ^ 2 - c ^ 2) / 2) * (a * b - c ^ 2) := by sorry
