theorem reciprocal_sum_inequality (a b c d : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d) (habcd : a * b * c * d = 1) : 1 / a + 1 / b + 1 / c + 1 / d + 9 / (a + b + c + d) ≥ 25 / 4 := by sorry
