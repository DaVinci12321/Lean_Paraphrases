theorem sum_positive_integers_with_integral_radical_expression : ∃ S : Finset ℕ, (∀ n : ℕ, n ∈ S ↔ 0 < n ∧ ∃ z : ℤ, 9 * Real.sqrt (n : ℝ) + 4 * Real.sqrt ((n + 2 : ℕ) : ℝ) - 3 * Real.sqrt ((n + 16 : ℕ) : ℝ) = (z : ℝ)) ∧ ∑ n in S, n = 18 := by sorry
theorem prime_power_system_classification (p x y : ℕ) : (Nat.Prime p ∧ 0 < x ∧ 0 < y ∧ ∃ k m : ℕ, x ^ (p - 1) + y = p ^ k ∧ x + y ^ (p - 1) = p ^ m) ↔ ((p = 3 ∧ x = 2 ∧ y = 5) ∨ (p = 3 ∧ x = 5 ∧ y = 2) ∨ ∃ n k : ℕ, p = 2 ∧ x = n ∧ y = 2 ^ k - n ∧ 0 < n ∧ n < 2 ^ k) := by sorry
