theorem sequence_perfect_power_iff (c : ℤ) (hc : 0 < c) (a : ℕ → ℤ) (ha₁ : a 1 = c) (ha_rec : ∀ n : ℕ, 1 ≤ n → a (n + 1) = (a n) ^ 2 + a n + c ^ 3) : (∃ k m : ℕ, ∃ d : ℤ, 1 ≤ k ∧ 2 ≤ m ∧ 1 ≤ d ∧ d ^ m = (a k) ^ 2 + c ^ 3) ↔ ∃ s : ℤ, 2 ≤ s ∧ c = s ^ 2 - 1 := by sorry
