theorem rational_as_ratio_of_sums_of_positive_cubes (r : ℚ) (hr : 0 < r) : ∃ a b c d : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ 0 < d ∧ r = (((a : ℚ) ^ 3 + (b : ℚ) ^ 3) / ((c : ℚ) ^ 3 + (d : ℚ) ^ 3)) := by sorry
