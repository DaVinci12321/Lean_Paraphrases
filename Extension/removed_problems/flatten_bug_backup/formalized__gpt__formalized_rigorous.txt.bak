theorem prime_set_closed_under_prime_divisors (M : Set ℕ) (h_nonempty : M.Nonempty) (h_subset : M ⊆ {p : ℕ | Nat.Prime p}) (h_closed : ∀ (k : ℕ), 0 < k → ∀ p : Fin k → ℕ, (∀ i, p i ∈ M) → ∀ q : ℕ, Nat.Prime q → q ∣ (∏ i, p i) + 1 → q ∈ M) : M = {p : ℕ | Nat.Prime p} := by sorry
theorem cyclic_power_prime_eq (n p : ℕ) (hn : 0 < n) (hp : Nat.Prime p) (a b c : ℤ) (h : a ^ n + (p : ℤ) * b = b ^ n + (p : ℤ) * c ∧ b ^ n + (p : ℤ) * c = c ^ n + (p : ℤ) * a) : a = b ∧ b = c := by sorry
theorem triangle_area_bound (a b c δ : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hab : a + b > c) (hac : a + c > b) (hbc : b + c > a) (hδ : δ = Real.sqrt (((a + b + c) / 2) * ((a + b + c) / 2 - a) * ((a + b + c) / 2 - b) * ((a + b + c) / 2 - c))) : δ ≤ (Real.sqrt 3 / 4) * ((a + b + c) / 3) ^ 2 ∧ (δ = (Real.sqrt 3 / 4) * ((a + b + c) / 3) ^ 2 ↔ a = b ∧ b = c) := by sorry
theorem extrema_sum_squares_under_sum_fourth_powers : (∀ x y z : ℝ, x ^ 4 + y ^ 4 + z ^ 4 = 1 → 1 ≤ x ^ 2 + y ^ 2 + z ^ 2 ∧ x ^ 2 + y ^ 2 + z ^ 2 ≤ Real.sqrt 3) ∧ (∃ x y z : ℝ, x ^ 4 + y ^ 4 + z ^ 4 = 1 ∧ x ^ 2 + y ^ 2 + z ^ 2 = 1) ∧ (∃ x y z : ℝ, x ^ 4 + y ^ 4 + z ^ 4 = 1 ∧ x ^ 2 + y ^ 2 + z ^ 2 = Real.sqrt 3) := by sorry
theorem decimal_digit_sum_multiples_of_nine : (∑ n ∈ Finset.Icc 9 999, if 9 ∣ n then (Nat.digits 10 n).sum else 0) = 1512 := by sorry
theorem greatest_possible_rational_sum : IsGreatest {z : ℚ | ∃ x y : ℚ, ∃ a b c d : ℕ, 0 < x ∧ 0 < y ∧ 0 < b ∧ 0 < d ∧ Nat.Coprime a b ∧ Nat.Coprime c d ∧ a + c = 9 ∧ b + d = 10 ∧ x = (a : ℚ) / (b : ℚ) ∧ y = (c : ℚ) / (d : ℚ) ∧ z = x + y} ((73 : ℚ) / 9) := by sorry
theorem polynomial_divisibility_of_composition (f : Polynomial ℂ) (n : ℕ) (hn : 0 < n) (h : ((Polynomial.X : Polynomial ℂ) - 1) ∣ f.comp ((Polynomial.X : Polynomial ℂ) ^ n)) : (((Polynomial.X : Polynomial ℂ) ^ n - 1) ∣ f.comp ((Polynomial.X : Polynomial ℂ) ^ n)) := by sorry
theorem classify_solutions (x n p : ℕ) (hx : 0 < x) (hn : 0 < n) (hp : Nat.Prime p) : x ^ 3 + 3 * x + 14 = 2 * p ^ n ↔ (x = 1 ∧ n = 2 ∧ p = 3) ∨ (x = 3 ∧ n = 2 ∧ p = 5) := by sorry
theorem limit_x_minus_xcos_over_x_minus_sin : Filter.Tendsto (fun x : ℝ => (x - x * Real.cos x) / (x - Real.sin x)) (𝓝[≠] (0 : ℝ)) (𝓝 (3 : ℝ)) := by sorry
theorem equal_distinct_prime_factors_difference (n : ℕ) (hn : 0 < n) : ∃ a b : ℤ, 0 < a ∧ 0 < b ∧ a - b = (n : ℤ) ∧ a.natAbs.primeFactors.card = b.natAbs.primeFactors.card := by sorry
theorem sequence_nonpositive (N : ℕ) (a : ℕ → ℝ) (h₀ : a 0 = 0) (hN : a N = 0) (hrec : ∀ i : ℕ, 1 ≤ i → i ≤ N - 1 → a (i + 1) - 2 * a i + a (i - 1) = (a i) ^ 2) : ∀ i : ℕ, 1 ≤ i → i ≤ N - 1 → a i ≤ 0 := by sorry
theorem unit_square_linear_map_probability (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) (hprob : MeasureTheory.volume {p : ℝ × ℝ | 0 ≤ p.1 ∧ p.1 ≤ 1 ∧ 0 ≤ p.2 ∧ p.2 ≤ 1 ∧ 0 ≤ 3 * p.1 + 2 * p.2 ∧ 3 * p.1 + 2 * p.2 ≤ 1 ∧ 0 ≤ p.1 + 4 * p.2 ∧ p.1 + 4 * p.2 ≤ 1} = (a : ℝ≥0∞) / (b : ℝ≥0∞)) : 100 * a + b = 820 := by sorry
theorem digit_equations_value (a b c d : ℤ) (ha : 0 ≤ a ∧ a ≤ 9) (hb : 0 ≤ b ∧ b ≤ 9) (hc : 0 ≤ c ∧ c ≤ 9) (hd : 0 ≤ d ∧ d ≤ 9) (h₁ : 6 * a + 9 * b + 3 * c + d = 88) (h₂ : a - b + c - d = -6) (h₃ : a - 9 * b + 3 * c - d = -46) : 1000 * a + 100 * b + 10 * c + d = 6507 := by sorry
theorem triangle_preservation_iff (t : ℝ) : (∀ a b c : ℝ, 0 < a ∧ 0 < b ∧ 0 < c ∧ a + b > c ∧ b + c > a ∧ c + a > b → 0 < a ^ 2 + b * c * t ∧ 0 < b ^ 2 + c * a * t ∧ 0 < c ^ 2 + a * b * t ∧ (a ^ 2 + b * c * t) + (b ^ 2 + c * a * t) > c ^ 2 + a * b * t ∧ (b ^ 2 + c * a * t) + (c ^ 2 + a * b * t) > a ^ 2 + b * c * t ∧ (c ^ 2 + a * b * t) + (a ^ 2 + b * c * t) > b ^ 2 + c * a * t) ↔ t ∈ Set.Icc (2 / 3 : ℝ) 2 := by sorry
theorem star_expression_maximum (star : ℝ → ℝ → ℝ) (hstar : ∀ a b : ℝ, star a b = Real.sin a * Real.cos b) (x y : ℝ) (hxy : star x y - star y x = 1) : IsGreatest {v : ℝ | ∃ a b : ℝ, star a b - star b a = 1 ∧ v = star a b + star b a} 1 := by sorry
theorem cot_cos_ratio_inequalities (α β : ℝ) (hα : 0 < α) (hαβ : α < β) (hβ : β < Real.pi / 2) : (Real.cos β / Real.sin β) / (Real.cos α / Real.sin α) < Real.cos β / Real.cos α ∧ Real.cos β / Real.cos α < β / α := by sorry
theorem positive_integer_solutions : ∀ n : ℕ, 0 < n → ((∃ x y : ℕ, 0 < x ∧ 0 < y ∧ y ^ 2 + x * y + 3 * x = n * (x ^ 2 + x * y + 3 * y)) ↔ n = 1 ∨ n = 3 ∨ n = 4 ∨ n = 9) := by sorry
theorem triangle_fermat_point_distance_bound (A B C F D E : ℝ × ℝ) (h_noncollinear : (B.1 - A.1) * (C.2 - A.2) - (B.2 - A.2) * (C.1 - A.1) ≠ 0) (hF_interior : ∃ α β γ : ℝ, 0 < α ∧ 0 < β ∧ 0 < γ ∧ α + β + γ = 1 ∧ F = α • A + β • B + γ • C) (hAFB_BFC : EuclideanGeometry.angle A F B = EuclideanGeometry.angle B F C) (hBFC_CFA : EuclideanGeometry.angle B F C = EuclideanGeometry.angle C F A) (hD : ∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ D = (1 - t) • A + t • C) (hE : ∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ E = (1 - t) • A + t • B) : dist A B + dist A C ≥ 4 * dist D E := by sorry
theorem six_sets_large_intersection (n : ℕ) (hn : 0 < n) (A : Fin 6 → Finset ℕ) (hsub : ∀ i, A i ⊆ Finset.Icc 1 n) (hcard : ∀ i, n / 4 ≤ (A i).card) : ∃ i j : Fin 6, i < j ∧ n / 30 ≤ (A i ∩ A j).card := by sorry
theorem no_integer_solutions : ¬ ∃ m n : ℤ, 5 * m ^ 2 - 6 * m * n + 7 * n ^ 2 = 1985 := by sorry
theorem iterated_cos_deriv (f : ℝ → ℝ) (a : ℝ) (hf : ∀ x : ℝ, f x = Real.cos (Real.cos (Real.cos (Real.cos (Real.cos (Real.cos (Real.cos (Real.cos x)))))))) (ha : a = Real.cos a) : deriv f a = a ^ 8 - 4 * a ^ 6 + 6 * a ^ 4 - 4 * a ^ 2 + 1 := by sorry
theorem positive_of_elementary_symmetric_positive (a b c : ℝ) (h₁ : a + b + c > 0) (h₂ : a * b + b * c + c * a > 0) (h₃ : a * b * c > 0) : a > 0 ∧ b > 0 ∧ c > 0 := by sorry
theorem cyclic_product_inequality (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (habc : a * b * c = 1) : (a * b + b * c + 1 / (c * a)) * (b * c + c * a + 1 / (a * b)) * (c * a + a * b + 1 / (b * c)) ≥ (1 + 2 * a) * (1 + 2 * b) * (1 + 2 * c) := by sorry
theorem find_z (x y z : ℤ) (hx : x = 11) (hy : y = 8) (h : 2 * x + 3 * z = 5 * y) : z = 6 := by sorry
theorem olympiad_problem (a b c d : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d) (habcd : a * b * c * d = 1) (h₁ : a ^ 2012 + 2012 * b = 2012 * c + d ^ 2012) (h₂ : 2012 * a + b ^ 2012 = c ^ 2012 + 2012 * d) : ∃ t : ℝ, 0 < t ∧ a = t ∧ b = 1 / t ∧ c = 1 / t ∧ d = t := by sorry
theorem functional_equation_value (f : ℝ → ℝ) (hcont : ContinuousOn f (Set.Ioi 0)) (hfunc : ∀ x y : ℝ, 0 < x → 0 < y → f (x * y) = f x + f y + 1) (h2 : f 2 = 0) : f 2015 = Real.log 2015 / Real.log 2 - 1 := by sorry
theorem no_continuous_functions_satisfying_product : ¬ ∃ f g h : ℝ → ℝ, Continuous f ∧ Continuous g ∧ Continuous h ∧ ∀ x y : ℝ, h (f x + g y) = x * y := by sorry
theorem log_div_lt_inv_sqrt (a b : ℝ) (ha : 0 < a) (hab : a < b) : (Real.log b - Real.log a) / (b - a) < 1 / Real.sqrt (a * b) := by sorry
theorem find_w (w : ℕ) (hw : 0 < w) (h : ((w : ℚ) + 8) * (5 / 6) = w) : w = 40 := by sorry
theorem cyclic_cubic_inequality (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) : a + b + c ≤ a ^ 3 / (b * c) + b ^ 3 / (c * a) + c ^ 3 / (a * b) ∧ (a ^ 3 / (b * c) + b ^ 3 / (c * a) + c ^ 3 / (a * b) = a + b + c ↔ a = b ∧ b = c) := by sorry
theorem base_representation_unique (n a b c : ℕ) (ha_pos : 0 < a) (ha_lt : a < 6) (hb_lt : b < 14) (hc_lt : c < 6) (h14 : n = 196 * a + 14 * b + c) (h15 : n = 225 * a + 15 * c + b) (h6 : n = 216 * a + 36 * c + 6 * a + c) : n = 925 := by sorry
theorem sin_eq_cos_two_pi_div_five : {x : ℝ | Real.sin x = Real.cos (2 * Real.pi / 5)} = {x : ℝ | ∃ k : ℤ, x = (k : ℝ) * Real.pi + ((-1 : ℝ) ^ k) * (Real.pi / 10)} := by sorry
theorem polynomial_characterization (P : ℝ[X]) : (∀ a b c : ℝ, a * b + b * c + c * a = 0 → P.eval (a - b) + P.eval (b - c) + P.eval (c - a) = 2 * P.eval (a + b + c)) ↔ ∃ a₂ a₄ : ℝ, P = Polynomial.C a₂ * Polynomial.X ^ 2 + Polynomial.C a₄ * Polynomial.X ^ 4 := by sorry
theorem rational_ternary_quadratic_unbounded_unit_level (a b c : ℚ) (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hiso : ∃ x₀ y₀ z₀ : ℚ, (x₀ ≠ 0 ∨ y₀ ≠ 0 ∨ z₀ ≠ 0) ∧ a * x₀ ^ 2 + b * y₀ ^ 2 + c * z₀ ^ 2 = 0) : ∀ N : ℚ, 0 < N → ∃ x₁ y₁ z₁ : ℚ, a * x₁ ^ 2 + b * y₁ ^ 2 + c * z₁ ^ 2 = 1 ∧ N < x₁ ^ 2 + y₁ ^ 2 + z₁ ^ 2 := by sorry
theorem functional_equation_characterization (f : ℝ → ℝ) : (∀ x y : ℝ, f x * f y = x * f (f (y - x)) + x * f (2 * x) + f (x ^ 2)) ↔ ((∀ x : ℝ, f x = 0) ∨ (∀ x : ℝ, f x = 3 * x)) := by sorry
theorem factorial_ratio_inequality (m n : ℕ) (hm : 0 < m) (hn : 0 < n) : (Nat.factorial (m + n) : ℝ) / (((m + n : ℕ) : ℝ) ^ (m + n)) < ((Nat.factorial m : ℝ) / ((m : ℝ) ^ m)) * ((Nat.factorial n : ℝ) / ((n : ℝ) ^ n)) := by sorry
theorem polynomial_degree_ge_prime_sub_one (p d : ℕ) (f : Polynomial ℤ) (hp : Nat.Prime p) (hdeg : f.natDegree = d) (h0 : f.eval 0 = 0) (h1 : f.eval 1 = 1) (hmod : ∀ n : ℤ, 0 < n → (p : ℤ) ∣ f.eval n ∨ (p : ℤ) ∣ (f.eval n - 1)) : p - 1 ≤ d := by sorry
theorem integral_rho_squared (a : ℝ) (ha : a > 0) : (∫ φ in (0 : ℝ)..Real.pi, ∫ ρ in (0 : ℝ)..a * Real.sin (2 * φ), ρ ^ 2) = (8 / 9 : ℝ) * a ^ 3 := by sorry
theorem floor_division_equals_twenty (V v : ℝ) (hV : V = 50) (hv : v = 2.5) : ⌊V / v⌋ = 20 := by sorry
theorem max_product : IsGreatest {p : ℝ | ∃ x y : ℝ, 0 < x ∧ 0 < y ∧ x + 1 / y = 3 ∧ y + 2 / x = 3 ∧ p = x * y} (3 + Real.sqrt 7) := by sorry
theorem ordered_five_tuple_solution_count_is_odd : Odd (Set.ncard {x : Fin 5 → ℕ | (∀ i, 0 < x i) ∧ Finset.univ.prod x = 5 * Finset.univ.sum (fun j => (Finset.univ.erase j).prod x)}) := by sorry
theorem delegation_count : Nat.choose 5 1 * Nat.choose 4 3 + Nat.choose 5 2 * Nat.choose 4 2 + Nat.choose 5 3 * Nat.choose 4 1 = 120 := by sorry
theorem functional_equation_iff (f : ℝ → ℝ) : (∀ x y : ℝ, 0 < x → 0 < y → f (x * y + f x) = x * f y + 2) ↔ (∀ x : ℝ, 0 < x → f x = x + 1) := by sorry
theorem integer_solutions (a b c : ℤ) (h₁ : a + b * c = 2017) (h₂ : b + c * a = 8) : c = -6 ∨ c = 0 ∨ c = 2 ∨ c = 8 := by sorry
theorem eventually_periodic_gcd_lcm_sequences (a b : ℕ → ℕ) (ha_pos : ∀ n, 0 < a n) (hb_pos : ∀ n, 0 < b n) (ha₀ : 2 ≤ a 0) (hb₀ : 2 ≤ b 0) (ha_rec : ∀ n, a (n + 1) = Nat.gcd (a n) (b n) + 1) (hb_rec : ∀ n, b (n + 1) = Nat.lcm (a n) (b n) - 1) : ∃ N t : ℕ, 0 < t ∧ ∀ n, N ≤ n → a (n + t) = a n := by sorry
theorem exists_strictly_increasing_sequences : ∃ a b : ℕ → ℕ, StrictMono a ∧ StrictMono b ∧ ∀ n : ℕ, a n * (a n + 1) ∣ (b n) ^ 2 + 1 := by sorry
theorem cyclic_inequality (a b c d : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (hbc : b ≤ c) (hcd : c ≤ d) : a * b ^ 3 + b * c ^ 3 + c * d ^ 3 + d * a ^ 3 ≥ a ^ 2 * b ^ 2 + b ^ 2 * c ^ 2 + c ^ 2 * d ^ 2 + d ^ 2 * a ^ 2 := by sorry
theorem cyclic_power_fraction_inequality (a b c : ℝ) (k : ℕ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (habc : a * b * c = 1) (hk : 2 ≤ k) : a ^ k / (a + b) + b ^ k / (b + c) + c ^ k / (c + a) ≥ (3 : ℝ) / 2 := by sorry
theorem no_positive_real_solutions : ¬ ∃ x y z : ℝ, 0 < x ∧ 0 < y ∧ 0 < z ∧ (2 * x^2 + y * z) * (2 * y^2 + x * z) * (2 * z^2 + x * y) = 26 * x^2 * y^2 * z^2 := by sorry
theorem inequality_for_positive_reals (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (habc : a * b * c = 1) : 1 / (1 + a + b) + 1 / (1 + b + c) + 1 / (1 + c + a) ≤ 1 / (2 + a) + 1 / (2 + b) + 1 / (2 + c) := by sorry
theorem consecutive_triple_power (n m k : ℕ) (hn : 0 < n) (hm : 0 < m) (hk : 0 < k) (h : (n - 1) * n * (n + 1) = m ^ k) : k = 1 := by sorry
theorem minimum_cos_alpha : IsLeast {x : ℝ | ∃ α β γ : ℝ, Real.cos α + Real.cos β + Real.cos γ = 1 ∧ Real.sin α + Real.sin β + Real.sin γ = 1 ∧ x = Real.cos α} ((-1 - Real.sqrt 7) / 4) := by sorry
theorem sum_distinct_quadratic_values_mod_100 (S : ℕ) (values : Finset ℕ) (hvalues : ∀ n : ℕ, n ∈ values ↔ ∃ a b c p q : ℕ, 0 < a ∧ Nat.Prime p ∧ Nat.Prime q ∧ p < q ∧ a * p ^ 2 + b * p + c = 17 ∧ a * q ^ 2 + b * q + c = 17 ∧ a * (p + q) ^ 2 + b * (p + q) + c = 47 ∧ n = a * (p * q) ^ 2 + b * (p * q) + c) (hS : S = ∑ n ∈ values, n) : S % 100 = 71 := by sorry
theorem exists_strictly_increasing_function : ∃ f : ℕ → ℕ, StrictMono f ∧ f 1 = 2 ∧ ∀ n : ℕ, f (f n) = f n + n := by sorry
theorem inequality_for_positive_reals (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) : b * c / (a ^ 2 + 2 * b * c) + c * a / (b ^ 2 + 2 * c * a) + a * b / (c ^ 2 + 2 * a * b) ≤ 1 ∧ 1 ≤ a ^ 2 / (a ^ 2 + 2 * b * c) + b ^ 2 / (b ^ 2 + 2 * c * a) + c ^ 2 / (c ^ 2 + 2 * a * b) := by sorry
theorem exists_four_pairwise_coprime (D : Finset ℕ) (hD : D ⊆ Finset.Icc 1 100) (hcard : D.card = 75) : ∃ x y z w : ℕ, x ∈ D ∧ y ∈ D ∧ z ∈ D ∧ w ∈ D ∧ x ≠ y ∧ x ≠ z ∧ x ≠ w ∧ y ≠ z ∧ y ≠ w ∧ z ≠ w ∧ Nat.gcd x y = 1 ∧ Nat.gcd x z = 1 ∧ Nat.gcd x w = 1 ∧ Nat.gcd y z = 1 ∧ Nat.gcd y w = 1 ∧ Nat.gcd z w = 1 := by sorry
theorem integer_solutions_cubic (x y : ℤ) : x ^ 3 - y ^ 3 = 2 * x * y + 8 ↔ (x = 2 ∧ y = 0) ∨ (x = 0 ∧ y = -2) := by sorry
theorem four_disks_area_difference (r : ℝ) (hr : 0 < r) (A B C D O : Set (EuclideanSpace ℝ (Fin 2))) (hA : A = Metric.ball ![0, r] r) (hB : B = Metric.ball ![r, 0] r) (hC : C = Metric.ball ![0, -r] r) (hD : D = Metric.ball ![-r, 0] r) (hO : O = Metric.ball ![0, 0] (2 * r)) : (MeasureTheory.volume (A ∪ B ∪ C ∪ D)).toReal - (MeasureTheory.volume (O \ (A ∪ B ∪ C ∪ D))).toReal = 8 * r ^ 2 := by sorry
theorem completed_square (z : ℝ) : 3 + 2 * z - 5 * z ^ 2 = -5 * (z - 1 / 5) ^ 2 + 16 / 5 := by sorry
theorem permutations_without_decreasing_subsequence_length_three : (Finset.univ.filter fun σ : Equiv.Perm (Fin 7) => ¬ ∃ i j k : Fin 7, i < j ∧ j < k ∧ σ i > σ j ∧ σ j > σ k).card = 429 := by sorry
theorem inequality_for_positive_reals (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (h : a * b + b * c + c * a = (1 : ℝ) / 3) : a / (a ^ 2 - b * c + 1) + b / (b ^ 2 - c * a + 1) + c / (c ^ 2 - a * b + 1) ≥ 1 / (a + b + c) := by sorry
theorem prime_pairs_divisibility (p q : ℕ) (hp : Nat.Prime p) (hq : Nat.Prime q) : (3 * p ^ (q - 1) + 1 ∣ 11 ^ p + 17 ^ p) ↔ (p = 3 ∧ q = 3) := by sorry
theorem sequence_value (a : ℕ → ℝ) (hpos : ∀ k, 1 ≤ k → k ≤ 100 → 0 < a k) (hrec : ∀ k, 2 ≤ k → k ≤ 100 → a k = (k : ℝ) * a (k - 1) / (a (k - 1) - (k - 1 : ℕ))) (heq : a 20 = a 23) : a 100 = 215 := by sorry
theorem fractional_part_integral_euler_mascheroni : (7 : ℝ) / 12 - Real.eulerMascheroniConstant = ∫ x in Set.Ioi (0 : ℝ), (Int.fract x) ^ 2 * (1 - Int.fract x) ^ 2 / (1 + x) ^ 5 := by sorry
theorem count_prime_power_quadruples (p n : ℕ) (hp : Nat.Prime p) (hn : 0 < n) : (Finset.filter (fun q : ((ℕ × ℕ) × ℕ) × ℕ => p ^ n ∣ q.1.1.1 * q.1.1.2 + q.1.2 * q.2 + 1) ((((Finset.range (p ^ n)).product (Finset.range (p ^ n))).product (Finset.range (p ^ n))).product (Finset.range (p ^ n)))).card = p ^ (3 * n) - p ^ (3 * n - 2) := by sorry
theorem integer_triples_classification (p q r : ℤ) : (1 < p ∧ p < q ∧ q < r ∧ (p - 1) * (q - 1) * (r - 1) ∣ p * q * r - 1) ↔ (p = 2 ∧ q = 4 ∧ r = 8) ∨ (p = 3 ∧ q = 5 ∧ r = 15) := by sorry
theorem integer_triples_sum_squares (x y z : ℤ) : x ^ 2 + y ^ 2 + z ^ 2 = 16 * (x + y + z) ↔ (x = 0 ∨ x = 16) ∧ (y = 0 ∨ y = 16) ∧ (z = 0 ∨ z = 16) := by sorry
theorem balanced_sign_arrays_count : Fintype.card {A : Fin 4 → Fin 4 → ({-1, 1} : Finset ℤ) // (∀ i : Fin 4, ∑ j : Fin 4, (A i j : ℤ) = 0) ∧ (∀ j : Fin 4, ∑ i : Fin 4, (A i j : ℤ) = 0)} = 90 := by sorry
theorem positive_reals_sum (x y z : ℝ) (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (h₁ : x ^ 2 + 2 * (y - 1) * (z - 1) = 85) (h₂ : y ^ 2 + 2 * (z - 1) * (x - 1) = 84) (h₃ : z ^ 2 + 2 * (x - 1) * (y - 1) = 89) : x + y + z = 18 := by sorry
theorem exp_integral_eq_eleven_fourths : let T : ℝ := ∫ x in (0 : ℝ)..Real.log 2, (2 * Real.exp (3 * x) + Real.exp (2 * x) - 1) / (Real.exp (3 * x) + Real.exp (2 * x) - Real.exp x + 1) Real.exp T = (11 : ℝ) / 4 := by sorry
theorem sin_arctan_eq (x : ℝ) : Real.sin (Real.arctan x) = x / Real.sqrt (1 + x ^ 2) := by sorry
theorem polynomial_minimum_value : (∀ P : Polynomial ℤ, P.eval 0 + P.eval 90 = 2018 → (782 : ℤ) ≤ |P.eval 20 + P.eval 70|) ∧ (∃ P : Polynomial ℤ, P.eval 0 + P.eval 90 = 2018 ∧ |P.eval 20 + P.eval 70| = 782) := by sorry
theorem determine_m (a b m : ℝ) (ha : a > 0) (hb : b > 0) (h₁ : 100 * a = 300) (h₂ : 100 * b = 200) (h₃ : 60 * 2 * a = 240) (h₄ : 60 * 2 * b = 300) (h₅ : 50 * 3 * a = 150) (h₆ : 50 * 3 * b = m) : m = 450 := by sorry
