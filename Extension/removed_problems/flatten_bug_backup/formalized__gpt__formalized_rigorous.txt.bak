theorem least_n_with_six_odd_and_twelve_even_divisors : 0 < (180 : ℕ) ∧ ((Nat.divisors 180).filter (fun d => d % 2 = 1)).card = 6 ∧ ((Nat.divisors 180).filter (fun d => d % 2 = 0)).card = 12 ∧ ∀ n : ℕ, 0 < n → ((Nat.divisors n).filter (fun d => d % 2 = 1)).card = 6 → ((Nat.divisors n).filter (fun d => d % 2 = 0)).card = 12 → 180 ≤ n := by sorry
