theorem coprime_ratio_radicals (r s : ℕ) (hr : 0 < r) (hs : 0 < s) (hcoprime : Nat.Coprime r s) (h : (r : ℝ) / (s : ℝ) = 2 * (Real.sqrt 2 + Real.sqrt 10) / (5 * Real.sqrt (3 + Real.sqrt 5))) : r = 4 ∧ s = 5 := by sorry
