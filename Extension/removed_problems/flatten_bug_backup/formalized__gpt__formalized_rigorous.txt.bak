theorem least_positive_odd_with_same_number_of_divisors_as_360 : 0 < (31185 : ℕ) ∧ Odd (31185 : ℕ) ∧ (Nat.divisors 31185).card = (Nat.divisors 360).card ∧ ∀ n : ℕ, 0 < n → Odd n → (Nat.divisors n).card = (Nat.divisors 360).card → 31185 ≤ n := by sorry
