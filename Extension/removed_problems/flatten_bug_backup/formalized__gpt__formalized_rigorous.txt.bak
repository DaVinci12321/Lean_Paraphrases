theorem fractional_part_sum_classification (k : ℕ) (hk : 0 < k) (hk_lt : k < 202) : (∃ n : ℕ, 0 < n ∧ (∑ i in Finset.Icc 1 k, Int.fract (((i * n : ℕ) : ℚ) / 202)) = (k : ℚ) / 2) ↔ k = 1 ∨ k = 100 ∨ k = 101 ∨ k = 201 := by sorry
