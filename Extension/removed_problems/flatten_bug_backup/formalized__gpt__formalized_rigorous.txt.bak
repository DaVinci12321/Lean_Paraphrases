theorem four_element_subsets_with_large_cyclic_gaps : ((Finset.Icc (1 : ℕ) 10).powerset.filter (fun S => S.card = 4 ∧ ∃ a b c d : ℕ, a ∈ S ∧ b ∈ S ∧ c ∈ S ∧ d ∈ S ∧ a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧ 4 ≤ Nat.dist a b ∧ 4 ≤ Nat.dist b c ∧ 4 ≤ Nat.dist c d ∧ 4 ≤ Nat.dist d a)).card = 36 := by sorry
theorem triangle_half_angle_inequality (a b c a' b' c' A B C A' B' C' : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (ha' : 0 < a') (hb' : 0 < b') (hc' : 0 < c') (hA : 0 < A ∧ A < Real.pi) (hB : 0 < B ∧ B < Real.pi) (hC : 0 < C ∧ C < Real.pi) (hA' : 0 < A' ∧ A' < Real.pi) (hB' : 0 < B' ∧ B' < Real.pi) (hC' : 0 < C' ∧ C' < Real.pi) (hangles : A + B + C = Real.pi) (hangles' : A' + B' + C' = Real.pi) (hsine_ab : a * Real.sin B = b * Real.sin A) (hsine_bc : b * Real.sin C = c * Real.sin B) (hsine_ca : c * Real.sin A = a * Real.sin C) (hsine_ab' : a' * Real.sin B' = b' * Real.sin A') (hsine_bc' : b' * Real.sin C' = c' * Real.sin B') (hsine_ca' : c' * Real.sin A' = a' * Real.sin C') : let s := a + b + c let s' := a' + b' + c' let lhs := (a / a') * Real.tan (A / 2) + (b / b') * Real.tan (B / 2) + (c / c') * Real.tan (C / 2) let rhs := Real.sqrt 3 * s / (2 * s') lhs ≥ rhs ∧ (lhs = rhs ↔ (A = B ∧ B = C) ∧ (A' = B' ∧ B' = C')) := by sorry
theorem ordered_triples_divisible_by_twenty : ((Finset.Icc 1 9 : Finset ℕ).product ((Finset.Icc 1 9 : Finset ℕ).product (Finset.Icc 1 9 : Finset ℕ))).filter (fun t => 20 ∣ t.1 * t.2.1 * t.2.2) |>.card = 102 := by sorry
theorem cyclic_fraction_inequality (a₁ a₂ a₃ a₄ : ℝ) (h₁ : 0 < a₁) (h₂ : 0 < a₂) (h₃ : 0 < a₃) (h₄ : 0 < a₄) : (a₁ + a₃) / (a₁ + a₂) + (a₂ + a₄) / (a₂ + a₃) + (a₃ + a₁) / (a₃ + a₄) + (a₄ + a₂) / (a₄ + a₁) ≥ 4 := by sorry
theorem cyclic_fraction_inequality (a b c d : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d) : 0 ≤ (a - b) / (b + c) + (b - c) / (c + d) + (c - d) / (d + a) + (d - a) / (a + b) := by sorry
