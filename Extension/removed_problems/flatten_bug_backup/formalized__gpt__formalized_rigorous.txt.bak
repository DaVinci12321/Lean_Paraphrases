theorem tenth_smallest_T_remainder : ∃ t : ℕ, (∃ n k : ℕ, n = k ^ 2 ∧ n % 1000 = 256 ∧ t = (n - 256) / 1000) ∧ ({u : ℕ | u < t ∧ ∃ n k : ℕ, n = k ^ 2 ∧ n % 1000 = 256 ∧ u = (n - 256) / 1000}).ncard = 9 ∧ t % 1000 = 170 := by sorry
