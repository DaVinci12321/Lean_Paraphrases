theorem integer_fraction_sets_eq (a : ℕ) (ha : 0 < a) (ha_ns : ¬ ∃ n : ℕ, n ^ 2 = a) : {k : ℕ | 0 < k ∧ ∃ x y : ℤ, Real.sqrt (a : ℝ) < (x : ℝ) ∧ (k : ℚ) = ((x : ℚ) ^ 2 - (a : ℚ)) / ((x : ℚ) ^ 2 - (y : ℚ) ^ 2)} = {k : ℕ | 0 < k ∧ ∃ x y : ℤ, 0 ≤ x ∧ (x : ℝ) < Real.sqrt (a : ℝ) ∧ (k : ℚ) = ((x : ℚ) ^ 2 - (a : ℚ)) / ((x : ℚ) ^ 2 - (y : ℚ) ^ 2)} := by sorry
