theorem sin_sqrt_bounds (α : ℝ) (hα : 0 ≤ α ∧ α ≤ Real.pi / 2) : 2 ≤ Real.sqrt (5 - 4 * Real.sin α) + Real.sin α ∧ Real.sqrt (5 - 4 * Real.sin α) + Real.sin α ≤ 9 / 4 := by sorry
theorem trigonometric_polynomial_bounds (a b A B : ℝ) (f : ℝ → ℝ) (hf : ∀ x : ℝ, f x = 1 - a * Real.cos x - b * Real.sin x - A * Real.cos (2 * x) - B * Real.sin (2 * x)) (hnonneg : ∀ x : ℝ, 0 ≤ f x) : a ^ 2 + b ^ 2 ≤ 2 ∧ A ^ 2 + B ^ 2 ≤ 1 := by sorry
